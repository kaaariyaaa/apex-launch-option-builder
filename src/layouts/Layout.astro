---
const { title = 'Apex Launch Option Builder' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101211" />
    <meta name="description" content="Apex Legendsの起動オプションを検索して組み合わせ、コマンドを作成。" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
